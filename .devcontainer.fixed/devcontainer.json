{
  "name": "Sky Wolf Studios",

  // 5 Oct 2026: this was "universal:2", and container creation failed on it with
  // error 1302 twice in one day (the codespace went to recovery mode both times).
  // ":2" is frozen at 2.13.1 (May 2025, Ubuntu 20.04). ":latest" is the image
  // Codespaces uses by itself when a repo has no devcontainer.json, and it built
  // on this codespace at 01:06 UTC 5 Oct, so it is the one image seen working here.
  // The failed build's own log was not kept, so the image is the inferred cause,
  // not a proven one: it is the only line of this file that acts before the
  // container exists. TEST THIS ON A THROWAWAY CODESPACE FIRST (HANDOFF.md).
  "image": "mcr.microsoft.com/devcontainers/universal:latest",

  // Reconstitutes the whole workspace on a fresh codespace: clones the sibling
  // repos beside this one and restores the memory directory from sws-memory.
  // Fetches only. It never merges and never touches local work.
  "postCreateCommand": "bash .devcontainer/bootstrap.sh || true",

  // Every time the codespace is (re)started, show what is dirty or unpushed.
  "postStartCommand": "bash workspace.sh || true",

  "customizations": {
    "vscode": {
      "settings": { "files.trimTrailingWhitespace": false }
    }
  }
}
