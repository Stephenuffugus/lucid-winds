# ═══════════════════════════════════════════════════════════════════
# LUCID WINDS — Production .htaccess
# Last updated: 2026-04-01
# ═══════════════════════════════════════════════════════════════════

# ── 1. FORCE HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── 2. GZIP / DEFLATE COMPRESSION ──
# Cuts ~2.3MB index.html down to ~500KB over the wire
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ── 3. CACHING RULES ──
<IfModule mod_headers.c>

  # index.html: 5min edge cache + stale-while-revalidate. Lets Cloudflare
  # serve repeat visits within the 5min window from the edge (sub-100ms
  # response vs. ~500-1500ms transit to Hostinger origin), saves 1.4MB
  # transfer per repeat visit. Deploys still go live within 5min, and
  # the LW_VERSION boot-check inside index.html still forces a hard
  # reload when the version string changes — so iteration loop is
  # preserved. Was no-cache+must-revalidate prior to 2026-04-28.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # studio.html / other HTML pages: same 5min edge cache.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # Core split-build scripts + engagement.js — must revalidate on every
  # load so deploys go live instantly. The old 1-year immutable rule
  # applied to every .js file and trapped users on stale core.js, etc.
  # The LW_VERSION check inside core.js could never fire because the
  # browser never re-fetched core.js to see the new version number.
  # engagement added 2026-04-28 — was falling through to Hostinger's
  # 7-day default and trapping players on stale counter-write code.
  <FilesMatch "^(core|app|systems|init|games|wild|dev|shared|engagement)\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ⛔⛔ SHARED CODE REVALIDATES. Same trap as sw.js below, found the same day:
  # `shell.js` is loaded by 66 play pages and `sunbeam-sdk.js` by every game on
  # the site, and NEITHER matched a rule above — so both sat on the host's 7-day
  # default. Measured live: shell.js?v=18 was a cf-cache HIT with
  # max-age=604800. The ?v= bump is the intended cache-buster, but forgetting it
  # once silently pins shared CODE for a week, and the failure looks like a game
  # bug rather than a stale file. no-cache still allows a cheap 304, so this
  # costs a revalidation, not a re-download.
  # ⛔ MODULAR GAME CODE REVALIDATES (2026-07-26, the Stephen's-phone lesson).
  # The LW app loads games/<id>.js?v=LW_VERSION, but the game files ship many
  # times between app bumps — a Cloudflare colo that cached the URL early served
  # STALE GAME CODE to its whole region through incognito, cleared data, and a
  # factory reset, because the pin lived in the CDN, not the device. A subdir
  # .htaccess did not take on this host (origin kept sending max-age=14400), so
  # the rule lives here via SetEnvIf, which the host provably honors.
  SetEnvIf Request_URI "^/games/.+\.js$" GAMEJS=1
  Header set Cache-Control "no-cache, must-revalidate" env=GAMEJS

  <FilesMatch "^(shell|sunbeam-sdk|feedback)\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ⛔⛔ SERVICE WORKERS MUST NEVER BE EDGE-CACHED.
  # A stale worker is not a stale asset, it is stale CODE that intercepts every
  # request the app makes — and a broken one can stop its own replacement from
  # ever being fetched. sw.js matched none of the .js rules above, so it fell
  # through to Hostinger's 7-day default. That is exactly how the 2026-07-26
  # Jimothy worker fix reached zero players: the edge had pinned sw.js?v=56 for
  # a week, so the app kept installing the broken worker from cache while the
  # repo, origin and the bare sw.js URL all looked correct.
  # FilesMatch tests the basename, so this covers every satellites/*/sw.js too.
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Game-specific scripts and word banks (games/*.js, word-banks.js) —
  # these genuinely don't change often and can stay aggressively cached.
  <FilesMatch "^(word-banks)\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^games/.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — unique filenames, cache aggressively (1 year)
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Manifest + JSON config
  <FilesMatch "\.(json|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

</IfModule>

# ── 4. SECURITY HEADERS ──
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Iframe policy — CSP frame-ancestors supersedes X-Frame-Options
  # on modern browsers and allows whitelisting minepi.com so the Pi
  # sandbox can embed lucidwinds.com for testing + production review.
  # 2026-07-17: listdle.com added — Conor embeds our submitted games in
  # game cards on his directory (our games are ad-free, so no revenue
  # concern; his page credits + links back). Without this the embeds
  # render BLANK cross-origin.
  # X-Frame-Options stays unset because it has no allow-list syntax.
  Header unset X-Frame-Options
  Header set Content-Security-Policy "frame-ancestors 'self' https://*.minepi.com https://minepi.com https://listdle.com https://*.listdle.com"

  # Control referrer leakage
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Lock down browser features — only allow what we use
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(self)"

  # XSS filter (legacy browsers)
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ── 5. MIME TYPES ──
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ── 6. DISABLE DIRECTORY LISTING ──
Options -Indexes
