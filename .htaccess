# ═══════════════════════════════════════════════════════════════════
# LUCID WINDS — Production .htaccess
# Last updated: 2026-04-01
# ═══════════════════════════════════════════════════════════════════

# ── 1. FORCE HTTPS ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── 2. GZIP / DEFLATE COMPRESSION ──
# Cuts ~2.3MB index.html down to ~500KB over the wire
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# ── 3. CACHING RULES ──
<IfModule mod_headers.c>

  # index.html: 5min edge cache + stale-while-revalidate. Lets Cloudflare
  # serve repeat visits within the 5min window from the edge (sub-100ms
  # response vs. ~500-1500ms transit to Hostinger origin), saves 1.4MB
  # transfer per repeat visit. Deploys still go live within 5min, and
  # the LW_VERSION boot-check inside index.html still forces a hard
  # reload when the version string changes — so iteration loop is
  # preserved. Was no-cache+must-revalidate prior to 2026-04-28.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # studio.html / other HTML pages: same 5min edge cache.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # Core split-build scripts + engagement.js — must revalidate on every
  # load so deploys go live instantly. The old 1-year immutable rule
  # applied to every .js file and trapped users on stale core.js, etc.
  # The LW_VERSION check inside core.js could never fire because the
  # browser never re-fetched core.js to see the new version number.
  # engagement added 2026-04-28 — was falling through to Hostinger's
  # 7-day default and trapping players on stale counter-write code.
  <FilesMatch "^(core|app|systems|init|games|wild|dev|shared|engagement)\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Game-specific scripts and word banks (games/*.js, word-banks.js) —
  # these genuinely don't change often and can stay aggressively cached.
  <FilesMatch "^(word-banks)\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^games/.*\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — unique filenames, cache aggressively (1 year)
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Manifest + JSON config
  <FilesMatch "\.(json|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

</IfModule>

# ── 4. SECURITY HEADERS ──
<IfModule mod_headers.c>
  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Block iframe embedding (clickjacking protection)
  Header set X-Frame-Options "SAMEORIGIN"

  # Control referrer leakage
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Lock down browser features — only allow what we use
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(self)"

  # XSS filter (legacy browsers)
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ── 5. MIME TYPES ──
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ── 6. DISABLE DIRECTORY LISTING ──
Options -Indexes
