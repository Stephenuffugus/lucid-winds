From cfbb539649d75f18311651cb7f8a98afdb688cfe Mon Sep 17 00:00:00 2001
From: Stephenuffugus <stephenfurpahs@gmail.com>
Date: Tue, 28 Jul 2026 03:47:53 +0000
Subject: [PATCH 1/3] 3D on a phone: the "turn it sideways" prompt was a dead
 end, and a desktop mouse prompt sat behind it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Stephen: "it tells you to turn it sideways, i do, and nothing happens."

Two separate walls, both only reachable after Launch (setupTouch runs after
insertCoin resolves, so neither shows during the Playroom lobby):

1. #rotate is opaque, inset:0, z-index:70, and had NO way out. It cleared only
   on a 'resize' that reported innerHeight <= innerWidth. Any phone that cannot
   actually deliver a landscape viewport — OS rotation lock on, an installed PWA
   whose manifest pins portrait, an iframe in a portrait container — left the
   player sealed behind a black screen permanently. It also covered #tapStart
   (z-65), which is the ONE control that would have rotated the screen for them
   via screen.orientation.lock('landscape').
   Now: listens to orientationchange + a matchMedia(orientation) change event +
   pageshow as well as resize, re-checks at +250ms/+700ms (mobile browsers report
   stale dimensions mid-rotation), treats the viewport as landscape if EITHER
   signal says so, and the prompt itself is tappable — it tries the fullscreen +
   orientation lock first, then gets out of the way regardless. Dismissal sticks,
   so rotating back to portrait cannot re-trap them. Also clears #tapStart in the
   same tap, so it is one tap into the game instead of two.

2. init() called setupTouch() (which hides #clickToPlay) and then unconditionally
   re-showed #clickToPlay four lines later — so every phone that got past the
   rotate gate was handed a desktop pointer-lock prompt, "Click to capture mouse",
   over the game. Now gated on !touch.on.

Verified headless through the real Playroom lobby on an emulated Pixel 9
(scratchpad rotate_verify.js), 0 JS errors, 6/6:
  - prompt appears in portrait
  - tapping it escapes into the game on a phone that never rotates
  - the same tap clears tapStart
  - rotating back to portrait does not re-trap
  - a normal phone rotating to landscape still clears it (no regression)
  - element under the player's thumb after escaping went from the desktop
    prompt paragraph to "stickR", the actual touch control

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 abduct-3d.html | 63 ++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 58 insertions(+), 5 deletions(-)

diff --git a/abduct-3d.html b/abduct-3d.html
index 4631eff..e6ad6e4 100644
--- a/abduct-3d.html
+++ b/abduct-3d.html
@@ -135,9 +135,14 @@
   body.touch #mapsToggle{ top:8px; width:34px; height:34px }
   #levelBar{ top:60px }
   #rotate{ position:fixed; inset:0; z-index:70; display:none; flex-direction:column; gap:14px;
-    align-items:center; justify-content:center; background:var(--bg); text-align:center }
+    align-items:center; justify-content:center; background:var(--bg); text-align:center;
+    cursor:pointer; -webkit-tap-highlight-color:transparent }
   #rotate .ph{ font-size:44px; animation:rot 1.6s ease-in-out infinite }
   @keyframes rot{ 0%,20%{ transform:rotate(0) } 60%,100%{ transform:rotate(90deg) } }
+  /* the way out — a phone that cannot rotate must never be a dead end */
+  #rotate .anyway{ margin-top:10px; border:1px solid var(--line); border-radius:999px;
+    padding:11px 20px; min-height:48px; display:flex; align-items:center;
+    color:var(--txt); font-size:13px; font-weight:700 }
   body.touch.portrait #rotate{ display:flex }
   #tapStart{ position:fixed; inset:0; z-index:65; display:none; flex-direction:column; gap:12px;
     align-items:center; justify-content:center; background:rgba(8,12,25,.92); text-align:center }
@@ -196,7 +201,8 @@
 
   <button id="mapsToggle" class="hidden">🗺</button>
   <div id="rotate"><div class="ph">📱</div><div style="font-weight:700">Turn your phone sideways</div>
-    <div style="color:var(--muted);font-size:12px">this game is played in landscape</div></div>
+    <div style="color:var(--muted);font-size:12px">this game is played in landscape</div>
+    <div class="anyway">Already sideways? Tap to play &rsaquo;</div></div>
   <div id="tapStart"><div class="big">▶ TAP TO PLAY</div><div class="sm">goes fullscreen · sound on</div></div>
 
   <div id="dropzone">Release to load map</div>
@@ -401,7 +407,10 @@ async function init(){
     onPlayerJoin(handleJoin);
     loadLevelList();
     started = true;
-    document.getElementById('clickToPlay').classList.remove('hidden');
+    // setupTouch() hid this two lines ago — re-showing it unconditionally put a
+    // desktop pointer-lock prompt ("Click to capture mouse") over the game on
+    // every phone, right after the player got past the rotate gate.
+    if(!touch.on) document.getElementById('clickToPlay').classList.remove('hidden');
   }catch(err){
     console.error(err);
     document.getElementById('errorMsg').textContent = String(err && err.message || err);
@@ -1453,8 +1462,52 @@ function setupTouch(){
     try{ document.documentElement.requestFullscreen && document.documentElement.requestFullscreen(); }catch(_){}
     try{ screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape').catch(()=>{}); }catch(_){}
   });
-  const orient = ()=> document.body.classList.toggle('portrait', innerHeight > innerWidth);
-  addEventListener('resize', orient); orient();
+  // ---- Orientation gate --------------------------------------------------
+  // The prompt must never become a wall. A phone with rotation lock on, an
+  // installed PWA whose manifest pins portrait, or an iframe in a portrait
+  // container all leave the viewport permanently portrait — and the old gate
+  // listened only to 'resize' and offered no way out, so the player sat behind
+  // an opaque full-screen overlay forever ("I turn it sideways and nothing
+  // happens"). Now: more signals, late re-checks, and a tap-to-play escape.
+  const rotEl = document.getElementById('rotate');
+  let rotateDismissed = false;
+
+  const isPortrait = ()=>{
+    let mq = null;
+    try{ mq = matchMedia('(orientation:portrait)').matches; }catch(_){}
+    const dims = innerHeight > innerWidth;
+    // Bias toward letting them play: only hold the gate when BOTH signals agree
+    // it is portrait. Mobile browsers report stale dimensions mid-rotation.
+    return mq === null ? dims : (mq && dims);
+  };
+  const orient = ()=> document.body.classList.toggle('portrait', !rotateDismissed && isPortrait());
+
+  // iOS/Android fire these at different times and some report the old size on
+  // the first tick, so re-check on a couple of short delays too.
+  const recheck = ()=>{ orient(); setTimeout(orient, 250); setTimeout(orient, 700); };
+  addEventListener('resize', recheck);
+  addEventListener('orientationchange', recheck);
+  addEventListener('pageshow', recheck);
+  try{
+    const mql = matchMedia('(orientation:portrait)');
+    mql.addEventListener ? mql.addEventListener('change', recheck) : mql.addListener(recheck);
+  }catch(_){}
+
+  // Tapping the prompt tries to rotate the screen for them (works on Android in
+  // fullscreen, no-ops on iOS) and then gets out of the way regardless, so the
+  // gate can never trap anyone. Also clears tapStart — it sits UNDER this
+  // overlay at z-65, so without this they would face a second identical-looking
+  // full-screen panel and one more tap.
+  rotEl.addEventListener('click', ()=>{
+    ensureAudio();
+    try{ document.documentElement.requestFullscreen && document.documentElement.requestFullscreen(); }catch(_){}
+    try{ screen.orientation && screen.orientation.lock && screen.orientation.lock('landscape').catch(()=>{}); }catch(_){}
+    rotateDismissed = true;
+    ts.style.display = 'none';
+    orient();
+  });
+
+  orient();
   const L = document.getElementById('stickL'), R = document.getElementById('stickR');
   let lId=null, lx0=0, ly0=0, rId=null, rx0=0, ry0=0;
   L.addEventListener('pointerdown', e=>{ ensureAudio(); lId=e.pointerId; lx0=e.clientX; ly0=e.clientY; L.setPointerCapture(lId); });
