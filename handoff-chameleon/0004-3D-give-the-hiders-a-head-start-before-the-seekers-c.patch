+    const left=hideLeft(), on=(role==='seeker' && left>0 && !abd);
+    hw.classList.toggle('on', on);
+    // keep the number fresh whenever a head start is running, not only while the
+    // blindfold happens to be up, so it can never be caught showing a stale value
+    if(left>0){ const n=$('hidewaitNum'); if(n) n.textContent=String(Math.ceil(left)); }
+  })();
   const phase = getState('phase') || 'waiting';
   const hiders = players.filter(p=> p.state.getState('role')==='hider');
   const alive  = hiders.filter(p=> !p.state.getState('abducted')).length;
@@ -1949,7 +1982,12 @@ function updateHUD(role, abd){
 
   // timer
   const tEl = $('timer');
-  if(phase==='playing'){ const left=((getState('roundEnds')||0)-Date.now())/1000;
+  const hl=hideLeft();
+  if(phase==='playing' && hl>0){
+    if(role==='hider') showBanner('','Hide! '+Math.ceil(hl),'The seekers are blind until this hits zero. Match the ground and hold still.');
+    else showBanner('','Scanners offline','The chameleons are choosing their spots.');
+  }
+  else if(phase==='playing'){ const left=((getState('roundEnds')||0)-Date.now())/1000;
     tEl.classList.remove('hidden'); $('timerText').textContent=fmt(left); tEl.classList.toggle('low', left<=20); }
   else tEl.classList.add('hidden');
 
