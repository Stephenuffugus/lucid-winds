+/* seconds of hider head start left, 0 once the seekers are loose */
+function hideLeft(){ const e=getState('hideEnds')||0; return Math.max(0,(e-Date.now())/1000); }
+function seekerBlind(){ return myRole()==='seeker' && hideLeft()>0; }
 function detectAbductions(dt){
+  if(hideLeft()>0) return;              // nobody gets caught during the head start
   const seekers = players.filter(p=> p.state.getState('role')==='seeker' && p.state.getState('beam'));
   const hiders  = players.filter(p=> p.state.getState('role')==='hider' && !p.state.getState('abducted'));
   for(const h of hiders){
@@ -1682,7 +1706,7 @@ function clientTick(dt){
     else beamEnergy = Math.min(1, beamEnergy + dt/7);
   }
   const phNow = getState('phase') || 'waiting';                  // solo rooms never write a phase — undefined IS waiting
-  const active = (phNow==='playing' || phNow==='waiting') && !abd;
+  const active = (phNow==='playing' || phNow==='waiting') && !abd && !seekerBlind();
   const canControl = document.pointerLockElement === renderer.domElement || gp.present || touch.on;
   if(canControl){
     applyGamepadLook(dt, role, abd);
@@ -1914,6 +1938,15 @@ const $ = id => document.getElementById(id);
 function fmt(sec){ sec=Math.max(0,Math.ceil(sec)); return Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0'); }
 
 function updateHUD(role, abd){
+  /* seeker blindfold + the hider's own countdown */
+  (function(){
