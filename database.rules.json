{
  "rules": {
    ".read": false,
    ".write": false,
    "party": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{4}$/)",
        "msgs": {
          "$msg": {
            ".validate": "newData.hasChildren(['t', 'from']) && newData.child('t').isString() && newData.child('t').val().length <= 40 && newData.child('from').isString() && newData.child('from').val().length <= 80"
          }
        },
        "meta": {
          ".validate": "newData.hasChildren(['game', 'created'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
