{
  "_": "Every physics and balance number in Keepsies. A literal constant in a .js file is a review failure (HANDOFF-KEEPSIES 5.7). The harness, the AI worker and the game all load this same file.",

  "physics": {
    "fixedStep": 0.008333333333333333,
    "gravityY": -9.81,
    "maxSubstepsPerFrame": 8,
    "ccdAboveSpeed": 2.0,
    "linearDamping": 0.02,
    "angularDamping": 0.02,
    "sleepLinear": 0.02,
    "sleepAngular": 0.5,
    "restedSeconds": 0.5,
    "resolveCapSeconds": 6.0,
    "_note": "damping is numerical only now; the feel comes from rollingMu (HANDOFF-KEEPSIES 4.1). Rapier has no rolling resistance, so physics.js applies it as a per step force and resets forces every step because addForce is persistent."
  },

  "surface": {
    "_": "rollingMu brakes travel; spinningMu brakes yaw about the contact normal. Rapier has neither, and without the second one a marble that picked up spin in a collision spins on the spot for ever and nothing in the scene ever sleeps.",
    "dirt":     { "friction": 0.55, "restitution": 0.35, "rollingMu": 0.02,  "spinningMu": 0.02 },
    "polished": { "friction": 0.18, "restitution": 0.60, "rollingMu": 0.008, "spinningMu": 0.008 },
    "ice":      { "friction": 0.04, "restitution": 0.60, "rollingMu": 0.002, "spinningMu": 0.002 },
    "sand":     { "friction": 0.90, "restitution": 0.20, "rollingMu": 0.06,  "spinningMu": 0.06 },
    "rubber":   { "friction": 0.60, "restitution": 1.10, "rollingMu": 0.02,  "spinningMu": 0.02, "exitSpeedClamp": 4.5 }
  },

