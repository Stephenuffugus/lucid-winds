{
 "_note": "Reactions (design 14 §5). A row names a trigger (hit, enter, power, equip, placed, clock), what met what (a: the source, b: what it met; tags, an id, a creature kind or a terrain), optional needs, the scope the effects act on (target, a: the source itself, radius, or fill: the connected tiles of a terrain tag), once or while, and the effects. Rows are read in file order and the FIRST MATCH WINS for one trigger instance. The player never sees this table; they see the pond light up. Every row here has a fixture in tools/fixtures.mjs and a mutation that breaks it.",
 "rows": [
  { "id": "pond_shock", "when": "power", "a": { "tags": ["electric"] }, "b": { "tags": ["liquid"] },
    "scope": { "kind": "fill", "terrain": "liquid", "max": 200 }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "stun", "sec": 2 }, { "do": "damage", "hp": 10 }, { "do": "fx", "id": "block", "sec": 0.6 }, { "do": "sound", "id": "bolt" } ],
    "say": "react.pondShock" },

  { "id": "fire_catches", "when": "power", "a": { "tags": ["fire"] }, "b": { "tags": ["flammable"] },
    "needs": { "raining": false },
    "scope": { "kind": "radius", "r": 14, "terrain": "flammable" }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "ignite" } ],
    "say": "react.fireCatches" },

  { "id": "ice_bridge", "when": "power", "a": { "tags": ["ice"] }, "b": { "tags": ["liquid"] },
    "scope": { "kind": "fill", "terrain": "water", "max": 60 }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "terrain", "to": "ice", "sec": 40 }, { "do": "sound", "id": "freeze" } ],
    "say": "react.iceBridge" },

  { "id": "crown_parade", "when": "equip", "a": { "id": "crown" }, "b": { "kind": "chicken" },
    "scope": { "kind": "radius", "r": 70, "only": { "kind": "chicken" } }, "mode": "once", "cooldownSec": 5,
    "effects": [ { "do": "follow" }, { "do": "fx", "id": "heart", "sec": 0.8 } ],
    "say": "react.crownParade" },

  { "id": "campfire_cooks", "when": "placed", "a": { "id": "fire" }, "b": { "tags": ["food"] },
    "scope": { "kind": "target" }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "cook" } ],
    "say": "react.cooked" },
  { "id": "food_by_campfire", "when": "placed", "a": { "tags": ["food"] }, "b": { "id": "fire" },
    "scope": { "kind": "target" }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "cook", "which": "a" } ],
    "say": "react.cooked" },

  { "id": "bounce_to_tower", "when": "enter", "a": { "tags": ["humanoid"] }, "b": { "id": "bouncepad" },
    "scope": { "kind": "a" }, "mode": "once", "cooldownSec": 3,
    "effects": [ { "do": "perchNear", "r": 64 }, { "do": "sound", "id": "land" } ],
    "say": "react.bounced" },

  { "id": "snow_golem", "when": "placed", "a": { "tags": ["hat"] }, "b": { "id": "snowman" },
    "scope": { "kind": "target" }, "mode": "once",
    "effects": [ { "do": "removeThing", "which": "a" }, { "do": "removeThing" }, { "do": "spawn", "kind": "golem", "tame": true }, { "do": "fx", "id": "magic", "sec": 0.8 } ],
    "say": "react.snowGolem" },

  { "id": "snowman_hat", "when": "placed", "a": { "id": "snowman" }, "b": { "tags": ["hat"] },
    "scope": { "kind": "target" }, "mode": "once",
    "effects": [ { "do": "removeThing" }, { "do": "removeThing", "which": "a" }, { "do": "spawn", "kind": "golem", "tame": true }, { "do": "fx", "id": "magic", "sec": 0.8 } ],
    "say": "react.snowGolem" },

  { "id": "lava_slime", "when": "enter", "a": { "kind": "slime" }, "b": { "terrain": "lava" },
    "scope": { "kind": "a" }, "mode": "once", "cooldownSec": 0,
    "effects": [ { "do": "become", "kind": "lavaslime" } ],
    "say": "react.lavaSlime" },

  { "id": "rains_fish", "when": "power", "a": { "tags": ["wind"] }, "b": { "tags": ["liquid"] },
    "scope": { "kind": "radius", "r": 40 }, "mode": "once", "cooldownSec": 10,
    "effects": [ { "do": "spawn", "kind": "fish", "n": 3, "spread": 30 }, { "do": "fx", "id": "beam", "sec": 0.6 } ],
    "say": "react.rainsFish" },

  { "id": "teddy_hug", "when": "equip", "a": { "id": "teddy" }, "b": { "tags": ["monster"] },
    "scope": { "kind": "b" }, "mode": "while", "cooldownSec": 0,
    "effects": [ { "do": "calm", "sec": 3 }, { "do": "fx", "id": "heart", "sec": 0.5, "every": 4 } ],
    "say": null },

  { "id": "foil_beam", "when": "hit", "a": { "id": "beam" }, "b": { "tags": ["foil"] },
    "scope": { "kind": "a" }, "mode": "once", "cooldownSec": 2,
    "effects": [ { "do": "deflect" }, { "do": "follow", "sec": 60 }, { "do": "fx", "id": "huh", "sec": 0.8 } ],
    "say": "react.foilBeam" },

  { "id": "catapult_launch", "when": "enter", "a": { "tags": ["livestock"] }, "b": { "id": "catapult" },
    "scope": { "kind": "a" }, "mode": "once", "cooldownSec": 4,
    "effects": [ { "do": "launch", "alt": 22, "px": 44 }, { "do": "sound", "id": "boom" } ],
    "say": "react.catapult" }
 ]
}
